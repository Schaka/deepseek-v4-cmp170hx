+    def validate_tokens_ex(self, tokens: list[int]) -> tuple[list[int], bool]:
+        """Non-advancing probe that also reports FSM termination.
+
+        Like validate_tokens, but stops as soon as the FSM reaches its
+        terminal state and reports whether it did. Tokens past the
+        terminal state are definitionally unconstrained garbage, so the
+        caller can distinguish "grammar completed + trailing garbage"
+        (truncate-and-finish is safe) from a mid-stream violation (FSM
+        still live). Breaking before offering the next token to an
+        already-terminated matcher also avoids the xgrammar C++ warning
+        (grammar_matcher.cc:612).
+        """
+        if self._is_terminated:
+            return [], True
+        accepted_tokens = []
+        terminated = False
+        for token in tokens:
+            if not self.matcher.accept_token(token):
+                break
+            accepted_tokens.append(token)
+            if self.matcher.is_terminated():
+                terminated = True
+                break
+        if len(accepted_tokens) > 0:
+            # Rollback the FSM to the initial state
+            self.matcher.rollback(len(accepted_tokens))
+        return accepted_tokens, terminated
+
     def rollback(self, num_tokens: int) -> None:
         self.matcher.rollback(num_tokens)
         self.num_processed_tokens -= num_tokens
