+    def _dsv4_signature_hit(self, request: Request) -> bool:
+        """DSV4 0014 C': does the decoded output tail contain a
+        hallucinated control-tag signature? Decode (not id-sequence
+        matching) so context-dependent tokenization cannot evade it."""
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return False
+        _tail = _tok.decode(request._output_token_ids[-24:])
+        return any(_s in _tail for _s in self._DSV4_SIG_STRINGS)
+
+    def _dsv4_soup_tags(self, request: Request, new_token_ids) -> set:
+        """DSV4 0015 v3: which signatures appear in the tokens appended
+        THIS block plus a 16-token overlap. A tag only counts while new
+        tokens keep arriving around it -- a legit tag parked at the end
+        of the output stops counting immediately, while soup keeps
+        producing tags every block. First-token prefilter keeps the
+        common case at an id scan with no tokenizer call."""
+        _win = request._output_token_ids[-(len(new_token_ids) + 16):]
+        if not any(_t in self._dsv4_sig_first_ids for _t in _win):
+            return set()
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return set()
+        _txt = _tok.decode(_win)
+        return {_s for _s in self._DSV4_SIG_STRINGS if _s in _txt}
+
+    def _dsv4_clean_cut(self, out_tail, decode, max_back: int = 16) -> int:
+        """DSV4 0017 P0-b: how many trailing tokens to drop so the visible
+        text does not end inside a half-written tag fragment. Fires only
+        when the decoded tail ends in an unclosed '<' + tagname run (no
+        '>' after the last '<', tagname starts alpha or '/'), so 'a < b'
+        math/prose never triggers. Bounded by max_back tokens."""
+        n = len(out_tail)
+        if n == 0:
+            return 0
+        txt = decode(out_tail[-min(n, 64):])
+        lt = txt.rfind("<")
+        if lt < 0:
+            return 0
+        after = txt[lt + 1:]
+        if not after:
+            return min(1, max_back)  # bare trailing '<'
+        if ">" in after:
+            return 0  # tag closed -> clean boundary
+        first = after[0]
+        if not (first.isalpha() or first == "/"):
+            return 0  # '< ' + space == not a tag start
+        if len(after) > 64:
+            return 0  # implausible fragment, leave it
+        need = len(txt) - lt  # chars from '<' to end of tail
+        for k in range(1, min(max_back, n) + 1):
+            if len(decode(out_tail[-k:])) >= need:
+                return k
+        return min(max_back, n)
+
