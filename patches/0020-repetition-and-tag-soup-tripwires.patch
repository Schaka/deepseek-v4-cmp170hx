+    def _dsv4_fuzzy_rep_lines(self, txt: str) -> "str | None":
+        """DSV4 0020: a cluster of lines sharing a 2-word opener AND a
+        repeated content word beyond it, or None. Returns a synthetic
+        descriptor (not a literal line) for logging."""
+        min_lines = int(os.environ.get("DSV4_REP_FUZZY_MIN_LINES", "8"))
+        min_hits = int(os.environ.get("DSV4_REP_FUZZY_MIN_HITS", "6"))
+        prefix_words = int(os.environ.get("DSV4_REP_FUZZY_PREFIX_WORDS", "2"))
+        overlap = float(os.environ.get("DSV4_REP_FUZZY_CONTENT_OVERLAP", "0.35"))
+
+        lines = [_l.strip().lower() for _l in txt.splitlines()]
+        lines = [_l for _l in lines if _l and _l not in self._DSV4_REP_WHITELIST]
+        if len(lines) < min_lines:
+            return None
+
+        buckets: dict[str, list[list[str]]] = {}
+        for _ln in lines:
+            words = _ln.split()
+            if len(words) < prefix_words:
+                continue
+            prefix = " ".join(words[:prefix_words])
+            buckets.setdefault(prefix, []).append(words[prefix_words:])
+
+        for _prefix, tails in buckets.items():
+            if len(tails) < min_hits:
+                continue
+            content_counts: dict[str, int] = {}
+            for tail_words in tails:
+                for w in {t.strip(".,!?;:\"\')]([") for t in tail_words}:
+                    if w in self._DSV4_REP_FUZZY_STOPWORDS or len(w) < 3:
+                        continue
+                    content_counts[w] = content_counts.get(w, 0) + 1
+            if not content_counts:
+                continue
+            top_word, top_count = max(
+                content_counts.items(), key=lambda kv: kv[1]
+            )
+            if top_count / len(tails) >= overlap:
+                return f"{_prefix}... [+{top_word}] x{len(tails)}"
+        return None
+
