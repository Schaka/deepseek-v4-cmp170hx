+            if not _ln or len(_ln) > 28 or _ln in self._DSV4_REP_WHITELIST:
+                continue
+            _counts[_ln] = _counts.get(_ln, 0) + 1
+        for _ln, _n in _counts.items():
+            if _n >= 5 and len(_tok.encode(_ln, add_special_tokens=False)) <= 6:
+                return _ln
+        if os.environ.get("DSV4_REP_FUZZY", "1") != "0":
+            return self._dsv4_fuzzy_rep_lines(_txt)
+        return None
+
