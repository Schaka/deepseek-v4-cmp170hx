+        """DSV4 0019: the short line repeated >=5x in this block's decode
+        window, or None. Char-length prefilter (<=28) keeps the encode
+        check rare; separators whitelisted; long lines never flagged.
+        DSV4 0020: falls back to the fuzzy varied-wording check above
+        when the exact check finds nothing -- different loop shape, same
+        decoded window, same streak/cutback machinery below."""
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return None
+        _w = max(len(new_token_ids) + 16,
+                 getattr(self, "_dsv4_rep_window", 160))
+        _win = request._output_token_ids[-_w:]
+        if not _win:
+            return None
+        _txt = _tok.decode(_win)
+        _counts: dict[str, int] = {}
+        for _ln in _txt.splitlines():
