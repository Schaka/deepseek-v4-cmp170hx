+    # legitimate parallel-structure list ("The function parses...",
+    # "The function validates...") that shares an opener but no topic.
+    _DSV4_REP_FUZZY_STOPWORDS = frozenset({
+        "let", "me", "the", "a", "an", "to", "for", "and", "or",
+        "of", "in", "on", "at", "is", "it", "this", "that", "i",
+        "will", "now", "then",
+    })
