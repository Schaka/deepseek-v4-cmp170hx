+    def _dsv4_splice_nudge(self, request: Request) -> bool:
+        """DSV4 0021: instead of ending the turn when a tripwire fires,
+        splice a corrective nudge into the request's own token history
+        and let generation continue in the SAME stream. Manual testing
+        found a short steering message ("go", "do it") reliably
+        unsticks the model instantly when typed by hand after a
+        tripwire-caught loop -- this automates exactly that instead of
+        just cutting the response short and leaving the client with a
+        dead turn and nothing to act on.
+
+        Mechanism: nudge tokens are appended to the request's token
+        history WITHOUT advancing num_computed_tokens, so the gap they
+        create is picked up by the scheduler's normal chunked-prefill
+        path (num_new_tokens = num_tokens - num_computed_tokens) on the
+        next step -- the same rollback shape already used for
+        speculative-decode rejection (`request.num_computed_tokens -=
+        num_rejected`, above in this file), not a new mechanism. The
+        caller must have already truncated the offending tail and
+        rolled num_computed_tokens back by the same amount BEFORE
+        calling this, so the gap this creates is exactly the nudge
+        text's token span.
+
+        Returns False once the per-request retry budget
+        (DSV4_NUDGE_MAX_RETRIES) is exhausted, so a model that won't
+        take the hint doesn't nudge forever -- caller falls back to the
+        pre-0021 finish-on-fire behavior in that case.
+        """
+        if not self._dsv4_nudge_enabled:
+            return False
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return False
+        _count = getattr(request, "_dsv4_nudge_count", 0)
+        if _count >= self._dsv4_nudge_max:
+            return False
+        nudge_ids = _tok.encode(self._dsv4_nudge_text, add_special_tokens=False)
+        if not nudge_ids:
+            return False
+        request._output_token_ids.extend(nudge_ids)
+        request._all_token_ids.extend(nudge_ids)
+        request._dsv4_nudge_count = _count + 1
+        # Fresh evaluation window post-nudge -- don't let the streak that
+        # just fired immediately re-fire on the very next check before
+        # the model has had a chance to respond to the nudge.
+        request._dsv4_rep_streak = 0
+        if getattr(request, "_dsv4_soup_streaks", None):
+            request._dsv4_soup_streaks.clear()
+        return True
+
