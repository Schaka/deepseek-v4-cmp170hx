+    def _dsv4_reopen_turn(self, request: Request) -> bool:
+        """DSV4 0022: alternate recovery strategy to _dsv4_splice_nudge().
+
+        0021's nudge splices freeform text mid-turn -- no template
+        boundary, same raw token stream the loop was already in. Live
+        testing past ~100k context found the model can take the nudge
+        and still keep mutating into new short repeats ("Let me check"
+        -> "Check the run" -> "Check.") rather than actually recovering,
+        burning the whole retry budget. This splices the exact
+        turn-boundary token sequence a genuine new chat completion would
+        produce for a fresh user turn saying "go" instead: close the
+        current (truncated) assistant turn with eos, open a user turn,
+        open the next assistant turn -- see assistant_msg_template /
+        USER_SP_TOKEN / ASSISTANT_SP_TOKEN in
+        vllm/tokenizers/deepseek_v4_encoding.py, which this mirrors. The
+        eos/User/Assistant strings must be recognized as this
+        tokenizer's own special tokens for encode() to resolve them to
+        the right ids rather than falling back to literal byte tokens --
+        true for the stock deepseek_v4 vocab, but if a future tokenizer
+        swap ever stops treating them as added/special tokens, this
+        silently degrades to nudge's regime (freeform text spliced with
+        no real boundary) rather than raising, so double check with
+        DSV4_RECOVERY_MODE=reopen's warning log line if in doubt.
+
+        Same splice-without-advancing-num_computed_tokens mechanism as
+        _dsv4_splice_nudge() -- see there for why that's safe. Shares
+        _dsv4_nudge_count / DSV4_NUDGE_MAX_RETRIES with the nudge path;
+        the two are mutually exclusive per request (selected once via
+        DSV4_RECOVERY_MODE, not mixed mid-request).
+        """
+        _tok = getattr(self.structured_output_manager, "tokenizer", None)
+        if _tok is None:
+            return False
+        _count = getattr(request, "_dsv4_nudge_count", 0)
+        if _count >= self._dsv4_nudge_max:
+            return False
+        reopen_ids = _tok.encode(self._dsv4_reopen_text, add_special_tokens=False)
+        if not reopen_ids:
+            return False
+        request._output_token_ids.extend(reopen_ids)
+        request._all_token_ids.extend(reopen_ids)
+        request._dsv4_nudge_count = _count + 1
+        request._dsv4_rep_streak = 0
+        if getattr(request, "_dsv4_soup_streaks", None):
+            request._dsv4_soup_streaks.clear()
+        return True
+
+    def _dsv4_recover(self, request: Request) -> bool:
+        """DSV4 0022: dispatch to the configured recovery strategy
+        (DSV4_RECOVERY_MODE: "nudge" [default] or "reopen"). See
+        _dsv4_splice_nudge() and _dsv4_reopen_turn() respectively.
+        DSV4_NUDGE=0 disables recovery entirely regardless of mode,
+        reverting to 0020's finish-on-fire behavior (pre-0021).
+        """
+        if not self._dsv4_nudge_enabled:
+            return False
+        if self._dsv4_recovery_mode == "reopen":
+            return self._dsv4_reopen_turn(request)
+        return self._dsv4_splice_nudge(request)
+
